---
import { getCollection, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Hyperspeed from "../components/Hyperspeed";

const aboutEntries = await getCollection("about");
const about = aboutEntries[0];
const { Content: AboutContent } = await render(about);

const projects = await getCollection("projects");
const sortedProjects = projects.sort(
  (a, b) => (a.data.sortOrder ?? 99) - (b.data.sortOrder ?? 99)
);

const currentYear = new Date().getFullYear();

// Hyperspeed effect options with Wipeout colors (white, grey, red)
const hyperspeedOptions = {
  onSpeedUp: () => {},
  onSlowDown: () => {},
  distortion: 'turbulentDistortion',
  length: 400,
  roadWidth: 10,
  islandWidth: 2,
  lanesPerRoad: 4,
  fov: 90,
  fovSpeedUp: 150,
  speedUp: 2,
  carLightsFade: 0.4,
  totalSideLightSticks: 20,
  lightPairsPerRoadWay: 40,
  shoulderLinesWidthPercentage: 0.05,
  brokenLinesWidthPercentage: 0.1,
  brokenLinesLengthPercentage: 0.5,
  lightStickWidth: [0.12, 0.5],
  lightStickHeight: [1.3, 1.7],
  movingAwaySpeed: [60, 80],
  movingCloserSpeed: [-120, -160],
  carLightsLength: [12, 80],
  carLightsRadius: [0.05, 0.14],
  carWidthPercentage: [0.3, 0.5],
  carShiftX: [-0.8, 0.8],
  carFloorSeparation: [0, 5],
  colors: {
    roadColor: 0x080808,
    islandColor: 0x0a0a0a,
    background: 0x000000,
    shoulderLines: 0xffffff,
    brokenLines: 0x888888,
    leftCars: [0xff1744, 0xffffff, 0x666666],
    rightCars: [0xff1744, 0xffffff, 0x666666],
    sticks: 0xff1744
  }
};
---

<Layout title={`${about.data.name} // ${about.data.title}`}>
  <div class="min-h-screen flex flex-col">
    
    <!-- Top Navigation Bar -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-wipeout-bg/90 backdrop-blur-sm border-b border-wipeout-gray">
      <div class="max-w-7xl mx-auto px-4">
        <nav class="flex items-center justify-between h-16">
          <!-- Logo / Name -->
          <a href="/" class="flex items-center gap-3 group">
            <div class="w-8 h-8 border-2 border-wipeout-red hex-clip flex items-center justify-center">
              <span class="text-wipeout-red font-bold text-sm">KM</span>
            </div>
            <span class="font-bold tracking-wider hidden sm:block">{about.data.name.toUpperCase()}</span>
          </a>
          
          <!-- Navigation Tabs (Wipeout style) -->
          <div class="flex items-center gap-2 sm:gap-3">
            <a href="#work" class="wipeout-tab text-xs sm:text-sm font-semibold tracking-wider">
              <span>WORK</span>
            </a>
            <a href="#about" class="wipeout-tab text-xs sm:text-sm font-semibold tracking-wider">
              <span>ABOUT</span>
            </a>
            <a href="#contact" class="wipeout-tab text-xs sm:text-sm font-semibold tracking-wider">
              <span>CONTACT</span>
            </a>
          </div>
          
          <!-- Nav Buttons (Wipeout style) -->
          <div class="hidden md:flex items-center gap-3 text-xs text-white/40">
            <div class="flex items-center gap-1">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7m8 14l-7-7 7-7"/>
              </svg>
              <span>NAV</span>
            </div>
            <div class="w-10 h-5 border border-wipeout-gray flex items-center justify-center">
              <div class="w-1.5 h-1.5 bg-wipeout-red pulse-red"></div>
            </div>
            <div class="flex items-center gap-1">
              <span>CONFIRM</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7"/>
              </svg>
            </div>
          </div>
        </nav>
      </div>
    </header>

    <!-- Hero Section with Hyperspeed Background -->
    <section class="relative min-h-screen flex items-center justify-center pt-16 overflow-hidden">
      <!-- Hyperspeed Background -->
      <div class="absolute inset-0 z-0">
        <Hyperspeed client:load effectOptions={hyperspeedOptions} />
      </div>
      
      <!-- Dark Overlay for readability -->
      <div class="absolute inset-0 bg-gradient-to-b from-wipeout-bg/60 via-wipeout-bg/40 to-wipeout-bg/90 z-10"></div>

      <!-- Animated Chevrons -->
      <div class="absolute inset-0 z-20 flex items-center justify-center pointer-events-none opacity-20">
        <svg class="w-[800px] h-[800px] chevron-animate" viewBox="0 0 200 200" fill="none">
          <path d="M100 10 L180 100 L100 190 L20 100 Z" stroke="rgba(255,23,68,0.3)" stroke-width="0.5"/>
        </svg>
        <svg class="w-[600px] h-[600px] absolute chevron-animate" style="animation-delay: 0.5s" viewBox="0 0 200 200" fill="none">
          <path d="M100 25 L165 100 L100 175 L35 100 Z" stroke="rgba(255,255,255,0.2)" stroke-width="0.5"/>
        </svg>
        <svg class="w-[400px] h-[400px] absolute chevron-animate" style="animation-delay: 1s" viewBox="0 0 200 200" fill="none">
          <path d="M100 40 L150 100 L100 160 L50 100 Z" stroke="rgba(255,23,68,0.4)" stroke-width="0.5"/>
        </svg>
      </div>

      <!-- Hero Content -->
      <div class="relative z-30 text-center px-6">
        <!-- Pre-title -->
        <div class="flex items-center justify-center gap-4 mb-6">
          <div class="w-12 h-[1px] bg-wipeout-red"></div>
          <span class="text-wipeout-red text-xs tracking-[0.3em] font-semibold">PORTFOLIO</span>
          <div class="w-12 h-[1px] bg-wipeout-red"></div>
        </div>
        
        <!-- Main Title -->
        <h1 class="text-5xl sm:text-7xl md:text-8xl font-black tracking-tight mb-4 glitch-hover red-text-glow">
          {about.data.name.toUpperCase()}
        </h1>
        
        <!-- Subtitle -->
        <p class="text-lg sm:text-xl text-white/60 tracking-[0.2em] uppercase mb-8">
          {about.data.title}
        </p>
        
        <!-- CTA Buttons -->
        <div class="flex flex-wrap items-center justify-center gap-4 mt-12">
          <a href="#work" class="wipeout-button font-bold tracking-wider">
            <span class="flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
              VIEW WORK
            </span>
          </a>
          <a href="#contact" class="wipeout-button font-bold tracking-wider border-wipeout-red">
            <span class="flex items-center gap-2">
              CONTACT
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </span>
          </a>
        </div>
      </div>

      <!-- Scroll Indicator -->
      <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 z-30">
        <span class="text-xs text-white/40 tracking-widest">SCROLL</span>
        <div class="w-[1px] h-12 bg-gradient-to-b from-wipeout-red to-transparent"></div>
      </div>
    </section>

    <!-- Work Section -->
    <section id="work" class="relative py-24 px-6 bg-wipeout-bg/95">
      <!-- Section Header -->
      <div class="max-w-7xl mx-auto mb-16">
        <div class="flex items-center gap-6">
          <div class="flex items-center gap-2">
            <svg class="w-6 h-6 text-wipeout-red" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
            </svg>
            <span class="text-wipeout-red font-bold tracking-wider">01</span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-black tracking-tight">SELECTED WORK</h2>
          <div class="flex-1 h-[1px] bg-wipeout-gray"></div>
        </div>
      </div>

      <!-- Projects Grid -->
      <div class="max-w-7xl mx-auto">
        <div class="grid gap-8">
          {sortedProjects.map((project, index) => (
            <article class="wipeout-card group cursor-pointer">
              <a href={`/projects/${project.id}`} class="block">
                <div class="p-6 sm:p-8">
                  <!-- Project Number -->
                  <div class="flex items-start justify-between mb-4">
                    <span class="text-wipeout-red font-mono text-sm">
                      {String(index + 1).padStart(2, '0')}
                    </span>
                    <div class="flex items-center gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
                      <span class="text-xs tracking-wider text-wipeout-red">VIEW PROJECT</span>
                      <svg class="w-4 h-4 text-wipeout-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                      </svg>
                    </div>
                  </div>
                  
                  <!-- Project Title -->
                  <h3 class="text-xl sm:text-2xl font-bold tracking-tight mb-3 group-hover:text-wipeout-red transition-colors">
                    {project.data.title}
                  </h3>
                  
                  <!-- Description -->
                  <p class="text-white/60 text-sm sm:text-base mb-6 max-w-2xl">
                    {project.data.description}
                  </p>
                  
                  <!-- Tags -->
                  <div class="flex flex-wrap gap-2">
                    {project.data.tags.map((tag) => (
                      <span class="text-xs font-mono px-3 py-1 bg-white/5 border border-wipeout-gray group-hover:border-wipeout-red transition-colors">
                        {tag.toUpperCase()}
                      </span>
                    ))}
                  </div>
                  
                  <!-- Meta Info -->
                  <div class="mt-6 pt-6 border-t border-wipeout-gray flex flex-wrap gap-6 text-xs text-white/40">
                    {project.data.role && (
                      <div>
                        <span class="block text-wipeout-red mb-1">ROLE</span>
                        {project.data.role}
                      </div>
                    )}
                    {project.data.timeline && (
                      <div>
                        <span class="block text-wipeout-red mb-1">TIMELINE</span>
                        {project.data.timeline.startDate ? new Date(project.data.timeline.startDate).getFullYear() : ''}
                        {project.data.timeline.endDate ? ` – ${new Date(project.data.timeline.endDate).getFullYear()}` : ' – PRESENT'}
                      </div>
                    )}
                    {project.data.tools && (
                      <div>
                        <span class="block text-wipeout-red mb-1">TOOLS</span>
                        {project.data.tools.slice(0, 3).join(' / ')}
                      </div>
                    )}
                  </div>
                </div>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- About Section -->
    <section id="about" class="relative py-24 px-6 border-t border-wipeout-gray bg-wipeout-bg-alt">
      <!-- Section Header -->
      <div class="max-w-7xl mx-auto mb-16 relative">
        <div class="flex items-center gap-6">
          <div class="flex items-center gap-2">
            <svg class="w-6 h-6 text-wipeout-red" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
            </svg>
            <span class="text-wipeout-red font-bold tracking-wider">02</span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-black tracking-tight">ABOUT</h2>
          <div class="flex-1 h-[1px] bg-wipeout-gray"></div>
        </div>
      </div>

      <div class="max-w-7xl mx-auto relative">
        <div class="grid lg:grid-cols-2 gap-12">
          <!-- Bio -->
          <div>
            <div class="prose prose-invert max-w-none">
              <AboutContent />
            </div>
            
            <!-- Education -->
            {about.data.education && (
              <div class="mt-8">
                <h3 class="text-wipeout-red text-sm font-bold tracking-wider mb-4">EDUCATION</h3>
                <div class="space-y-4">
                  {about.data.education.map((edu) => (
                    <div class="border-l-2 border-wipeout-gray pl-4 hover:border-wipeout-red transition-colors">
                      <p class="font-bold">{edu.institution}</p>
                      <p class="text-white/60 text-sm">{edu.degree}</p>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>
          
          <!-- Skills & Info -->
          <div class="space-y-8">
            <!-- Skills -->
            <div>
              <h3 class="text-wipeout-red text-sm font-bold tracking-wider mb-4">SKILLS</h3>
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                {about.data.skills.map((skill) => (
                  <div class="wipeout-card p-3 text-center hover:border-wipeout-red transition-colors">
                    <span class="text-xs font-mono">{skill.toUpperCase()}</span>
                  </div>
                ))}
              </div>
            </div>
            
            <!-- Experience -->
            {about.data.experience && (
              <div>
                <h3 class="text-wipeout-red text-sm font-bold tracking-wider mb-4">EXPERIENCE</h3>
                <div class="space-y-3">
                  {about.data.experience.map((exp) => (
                    <div class="flex items-center gap-4 p-3 bg-white/5 border border-wipeout-gray hover:border-wipeout-red transition-colors">
                      <div class="w-2 h-2 bg-wipeout-red"></div>
                      <div>
                        <p class="font-bold text-sm">{exp.company}</p>
                        <p class="text-white/60 text-xs">{exp.role}</p>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="relative py-24 px-6 border-t border-wipeout-gray bg-wipeout-bg">
      <!-- Section Header -->
      <div class="max-w-7xl mx-auto mb-16">
        <div class="flex items-center gap-6">
          <div class="flex items-center gap-2">
            <svg class="w-6 h-6 text-wipeout-red" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
            </svg>
            <span class="text-wipeout-red font-bold tracking-wider">03</span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-black tracking-tight">CONTACT</h2>
          <div class="flex-1 h-[1px] bg-wipeout-gray"></div>
        </div>
      </div>

      <div class="max-w-7xl mx-auto">
        <div class="grid lg:grid-cols-2 gap-12">
          <!-- Contact Info -->
          <div>
            <p class="text-white/60 text-lg mb-8">
              Interested in working together? Let's connect and discuss your project.
            </p>
            
            <div class="space-y-6">
              {about.data.contact?.email && (
                <a 
                  href={`mailto:${about.data.contact.email}`}
                  class="flex items-center gap-4 group"
                >
                  <div class="w-12 h-12 border border-wipeout-gray flex items-center justify-center group-hover:border-wipeout-red group-hover:bg-wipeout-red transition-all">
                    <svg class="w-5 h-5 group-hover:text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                  </div>
                  <div>
                    <span class="text-wipeout-red text-xs font-bold tracking-wider block">EMAIL</span>
                    <span class="text-lg group-hover:text-wipeout-red transition-colors">{about.data.contact.email}</span>
                  </div>
                </a>
              )}
              
              {about.data.contact?.phone && (
                <div class="flex items-center gap-4">
                  <div class="w-12 h-12 border border-wipeout-gray flex items-center justify-center">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                    </svg>
                  </div>
                  <div>
                    <span class="text-wipeout-red text-xs font-bold tracking-wider block">PHONE</span>
                    <span class="text-lg">{about.data.contact.phone}</span>
                  </div>
                </div>
              )}
            </div>
          </div>
          
          <!-- Social Links -->
          <div>
            <h3 class="text-wipeout-red text-sm font-bold tracking-wider mb-6">CONNECT</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {about.data.socials.map((social) => (
                <a
                  href={social.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="wipeout-card p-4 flex items-center gap-4 group hover:border-wipeout-red"
                >
                  <div class="w-10 h-10 border border-wipeout-gray flex items-center justify-center group-hover:border-wipeout-red group-hover:bg-wipeout-red transition-all">
                    <svg class="w-4 h-4 group-hover:text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                    </svg>
                  </div>
                  <span class="font-bold text-sm group-hover:text-wipeout-red transition-colors">{social.platform.toUpperCase()}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="relative py-8 px-6 border-t border-wipeout-gray bg-wipeout-bg-alt">
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-4">
          <div class="w-8 h-8 border-2 border-wipeout-red hex-clip flex items-center justify-center">
            <span class="text-wipeout-red font-bold text-sm">KM</span>
          </div>
          <span class="text-white/40 text-sm">© {currentYear} {about.data.name}</span>
        </div>
        
        <!-- Nav & Confirm Buttons -->
        <div class="flex items-center gap-4">
          <div class="flex items-center gap-2 text-white/40 text-xs">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7m8 14l-7-7 7-7"/>
            </svg>
            <span>NAV</span>
          </div>
          <div class="w-12 h-6 border border-wipeout-gray flex items-center justify-center gap-1">
            <div class="w-1.5 h-1.5 bg-wipeout-red pulse-red"></div>
            <div class="w-1.5 h-1.5 bg-white/30"></div>
            <div class="w-1.5 h-1.5 bg-white/30"></div>
          </div>
          <div class="flex items-center gap-2 text-white/40 text-xs">
            <span>CONFIRM</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7"/>
            </svg>
          </div>
        </div>
      </div>
    </footer>
  </div>
</Layout>
