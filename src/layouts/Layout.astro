---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700;800;900&family=Share+Tech+Mono&display=swap" rel="stylesheet">
  </head>
  <body class="min-h-screen bg-wipeout-bg text-wipeout-white font-display">
    <!-- Dot Grid Background -->
    <div class="fixed inset-0 dot-grid-dense pointer-events-none opacity-30"></div>
    
    <!-- Dither Overlay -->
    <div class="fixed inset-0 dither-overlay pointer-events-none"></div>
    
    <!-- Speed Lines (Background Animation) -->
    <div class="fixed inset-0 pointer-events-none overflow-hidden opacity-20">
      <div class="speed-line absolute top-[20%] left-0 w-32 h-[2px] bg-gradient-to-r from-transparent via-wipeout-red to-transparent" style="animation-delay: 0s;"></div>
      <div class="speed-line absolute top-[40%] left-0 w-48 h-[1px] bg-gradient-to-r from-transparent via-white to-transparent" style="animation-delay: 1s;"></div>
      <div class="speed-line absolute top-[60%] left-0 w-24 h-[2px] bg-gradient-to-r from-transparent via-wipeout-red to-transparent" style="animation-delay: 2s;"></div>
      <div class="speed-line absolute top-[80%] left-0 w-40 h-[1px] bg-gradient-to-r from-transparent via-white to-transparent" style="animation-delay: 0.5s;"></div>
    </div>
    
    <!-- Main Content -->
    <div class="relative z-10 min-h-screen flex flex-col">
      <slot />
    </div>
  </body>
</html>
